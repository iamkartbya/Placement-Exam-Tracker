    {
      "parameters": {
        "text": "=Today: {{ $now.setZone(\"Asia/Calcutta\").toISO() }}\nEmail received: {{ $json.received }}\nFrom: {{ $json.from }}\nSubject: {{ $json.subject }}\nStudent (Kartbya Kumar, reg no 43110402) found in the email or attached list: {{ $json.shortlisted ? \"YES\" : \"NO\" }}\n\n{{ $json.content }}",
        "attributes": {
          "attributes": [
            {
              "name": "is_exam",
              "type": "boolean",
              "description": "true only if this email announces a placement exam, online test, coding challenge, assessment, interview round or recruitment drive with a specific date or deadline. This includes on-campus placement announcements AND off-campus emails sent directly by a company, recruiter or test platform (HackerRank, HackerEarth, Mettl, SHL etc.) about the student's own application. false for job alerts, job recommendation digests, application-received acknowledgements without a test date, rejections, results, newsletters, or anything without a date.",
              "required": true
            },
            {
              "name": "is_off_campus",
              "type": "boolean",
              "description": "true if the email comes directly from a company, recruiter, job portal or test platform about the student's own off-campus application; false if it is a college placement cell / Google Group announcement"
            },
            {
              "name": "company",
              "description": "Hiring company or organiser name"
            },
            {
              "name": "exam_title",
              "description": "Short title, e.g. \"Online Assessment\" or \"Technical Interview\""
            },
            {
              "name": "exam_start",
              "description": "Exam start as ISO 8601 in 24-hour time with +05:30 offset, e.g. 2026-11-20T10:00:00+05:30. Convert 12-hour times carefully: p.m./PM adds 12 hours (10:51 p.m. = 22:51, 2 PM = 14:00), 12 a.m. = 00:00, 12 p.m. = 12:00. If it is a take-anytime test with only a deadline, use the deadline date and time. If no time is given use 09:00. If the year is missing, use the next occurrence after the received date. Empty if unknown."
            },
            {
              "name": "duration_minutes",
              "type": "number",
              "description": "Exam duration in minutes; 60 if not stated"
            },
            {
              "name": "location",
              "description": "Venue, lab, or test link"
            },
            {
              "name": "details",
              "description": "Brief summary: eligibility, roles/JD, registration deadline, links, reporting time"
            }
          ]
        },
        "options": {}
      },
