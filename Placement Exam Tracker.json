    {
      "parameters": {
        "jsCode": "const groups = {};\nconst order = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  if (!j.email_id) continue;\n  if (!groups[j.email_id]) {\n    groups[j.email_id] = { subject: '', from: '', received: '', body: '', parts: [] };\n    order.push(j.email_id);\n  }\n  const g = groups[j.email_id];\n  if (j.subject) g.subject = j.subject;\n  if (j.from) g.from = j.from;\n  if (j.received) g.received = j.received;\n  if (j.kind === 'body') g.body = String(j.text || '');\n  else if (j.text) g.parts.push(String(j.text));\n}\nreturn order.map(function (id) {\n  const g = groups[id];\n  const full = [g.body].concat(g.parts).join('\\n');\n  const norm = full.toLowerCase().replace(/\\S+@\\S+/g, ' ').replace(/\\s+/g, ' ');\n  const shortlisted = norm.includes('43110402') || /kartbya\\s*kumar/.test(norm) || /kumar\\s*,?\\s*kartbya/.test(norm);\n  return { json: { email_id: id, subject: g.subject, from: g.from, received: g.received, shortlisted: shortlisted, content: full.slice(0, 20000) } };\n});"
      },
      "id": "bee09414-5157-47bb-9d75-d4dddda044c5",
      "name": "Combine Text and Check Name",
      "type": "n8n-nodes-base.code",
