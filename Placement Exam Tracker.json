    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const html = typeof j.html === 'string'\n    ? j.html.replace(/<(style|script)[^>]*>[^]*?<.(style|script)>/gi, ' ').replace(/<br[^>]*>/gi, '\\n').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ')\n    : '';\n  const body = String(j.text || html || '').replace(/[ \\t]+/g, ' ');\n  const base = { email_id: j.id, subject: j.subject || '', from: (j.from && j.from.text) || '', received: j.date || '' };\n  out.push({ json: Object.assign({}, base, { kind: 'body', text: 'EMAIL BODY:\\n' + body }) });\n  const bins = item.binary || {};\n  for (const key of Object.keys(bins)) {\n    const b = bins[key];\n    const fileName = b.fileName || key;\n    const name = fileName.toLowerCase();\n    const mime = String(b.mimeType || '').toLowerCase();\n    let kind = 'other';\n    if (mime.includes('pdf') || name.endsWith('.pdf')) kind = 'pdf';\n    else if (name.endsWith('.xlsx') || name.endsWith('.xls') || mime.includes('spreadsheet') || mime.includes('excel')) kind = 'excel';\n    else if (name.endsWith('.csv') || mime.includes('csv')) kind = 'csv';\n    const entry = { json: Object.assign({}, base, { kind: kind, fileName: fileName, text: kind === 'other' ? '[Attachment not readable: ' + fileName + ']' : '' }) };\n    if (kind !== 'other') entry.binary = { data: b };\n    out.push(entry);\n  }\n}\nreturn out;"
      },
